{
  "name": "convertly",
  "version": "1.1.0",
  "private": true,
  "description": "Convertly — private, local file conversion, compression and manipulation for Chrome.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diogosilvasoares2121-prog/convertly.git"
  },
  "scripts": {
    "dev": "node scripts/licenses.mjs && vite build --mode development --watch",
    "build": "node scripts/licenses.mjs && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "size-report": "node scripts/size-report.mjs",
    "icons": "node scripts/icons.mjs",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "licenses": "node scripts/licenses.mjs",
    "release:check": "node scripts/release-check.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && npm run release:check && npm run package"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "fflate": "0.8.3",
    "libarchive.js": "2.0.2",
    "libheif-js": "1.23.5",
    "lucide-preact": "1.52.0",
    "marked": "18.1.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "preact": "10.29.8",
    "utif": "3.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "spdx-license-list": "6.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://diogosilvasoares2121-prog.github.io/convertly/",
  "bugs": {
    "url": "https://github.com/diogosilvasoares2121-prog/convertly/issues"
  }
}
